{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haley-wali-manager",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "manager.haleywali.pk",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haley-wali-production",
      "database_id": "b767f91b-1057-47c9-890f-a7d30f989517",
      "migrations_dir": "drizzle"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_STOREFRONT_ORIGIN": "https://haleywali.pk,https://www.haleywali.pk"
  }
}
