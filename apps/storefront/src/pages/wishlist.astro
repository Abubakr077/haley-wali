---
import WishlistPage from "../components/WishlistPage";
import BaseLayout from "../layouts/BaseLayout.astro";

const apiBase = import.meta.env.PUBLIC_CATALOG_API_BASE ?? "http://127.0.0.1:3000";
---

<BaseLayout title="Wishlist — Haley Wali" description="Saved Haley Wali clothing articles on this device." indexable={false}>
  <section class="collection-head">
    <h1 class="display-title">Wishlist</h1>
  </section>
  <WishlistPage apiBase={apiBase} client:load />
</BaseLayout>
