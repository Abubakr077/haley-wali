---
import BagPage from "../components/BagPage";
import BaseLayout from "../layouts/BaseLayout.astro";

const apiBase = import.meta.env.PUBLIC_CATALOG_API_BASE ?? "http://127.0.0.1:3000";
---

<BaseLayout
  title="Your Bag — Haley Wali"
  description="Review selected Haley Wali articles before Cash on Delivery checkout."
  indexable={false}
>
  <section class="page-shell">
    <p class="eyebrow">SHOPPING BAG</p>
    <h1 class="display-title">Your articles</h1>
    <BagPage apiBase={apiBase} client:load />
  </section>
</BaseLayout>
