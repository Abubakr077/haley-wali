---
import type { PublishedReview } from "../lib/products";

const { reviews } = Astro.props as { reviews: PublishedReview[] };
const dateFormatter = new Intl.DateTimeFormat("en-PK", { dateStyle: "medium" });
const hasOnlySample = reviews.length === 1 && reviews[0]?.isSample;
---

{reviews.length ? (
  <section class="sb-home-section sb-latest-reviews" aria-labelledby="latest-reviews-heading">
    <header class="sb-section-heading">
      <div>
        <p class="sb-kicker">CUSTOMER FEEDBACK</p>
        <h2 id="latest-reviews-heading">What customers are saying</h2>
      </div>
      <p>{hasOnlySample ? "A preview of how approved customer feedback will appear here." : "Recent feedback shared by Haley Wali customers and checked before publication."}</p>
    </header>
    <div class:list={["home-review-grid", { "is-single": reviews.length === 1 }]}>
      {reviews.map((review) => (
        <article class:list={["home-review-card", { "has-photo": Boolean(review.imageUrl) }]}>
          {review.imageUrl ? <img src={review.imageUrl} alt={`Photo shared in a review of ${review.articleName}`} loading="lazy" /> : null}
          <div class="home-review-copy">
            <div class="home-review-meta">
              <span class="review-stars" aria-label={`${review.rating} out of 5 stars`}>{"★".repeat(review.rating)}{"☆".repeat(5 - review.rating)}</span>
              {review.isSample ? <span class="home-review-sample">SAMPLE REVIEW</span> : <time datetime={review.createdAt}>{dateFormatter.format(new Date(review.createdAt))}</time>}
            </div>
            <span class="home-review-quote" aria-hidden="true">“</span>
            {review.title ? <h3>{review.title}</h3> : null}
            <p>{review.comment}</p>
            <footer>
              <div class="home-review-author"><span aria-hidden="true">{review.name.trim().charAt(0).toUpperCase()}</span><strong>{review.name}</strong></div>
              <a href={review.productId ? `/product?id=${encodeURIComponent(review.productId)}#reviews-heading` : "/shop"}>
                {review.articleImageUrl ? <img src={review.articleImageUrl} alt="" loading="lazy" /> : null}
                <span><small>REVIEWED ARTICLE</small>{review.articleName}</span>
              </a>
            </footer>
          </div>
        </article>
      ))}
    </div>
  </section>
) : null}
